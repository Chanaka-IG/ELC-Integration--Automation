# ── OrangeHRM (QA instance) ──────────────────────────────────────────────
# OrangeHRM 8.1 Enterprise (JN Group QA instance)
OHRM_URL=https://8101jnb1nw-temp14-kord.orangehrm.com
# Sysadmin login — used for ALL UI actions (PIM entry + RabbitMQ trigger)
OHRM_SYSADMIN_USER=_ohrmSysAdmin_
OHRM_SYSADMIN_PASS=
# OAuth2 client (client_credentials grant) for the changed-employee report /
# employee APIs. Token endpoint: {OHRM_URL}/oauth/issueToken
OHRM_CLIENT_ID=
OHRM_CLIENT_SECRET=

# ── Celigo (integrator.io) ───────────────────────────────────────────────
CELIGO_API_BASE=https://api.integrator.io/v1
CELIGO_API_TOKEN=
# [JN] [BIZPAY] [4.0] [QA] - Integration
CELIGO_INTEGRATION_ID=6a436a975a81b3a657c433ea
# [OHRM -> BIZPAY] | Sync Employees (scheduled every 5 min)
CELIGO_SYNC_EMPLOYEES_FLOW_ID=6a436b38c2387aaa87a5312c

# ── BizPay (sandbox) ─────────────────────────────────────────────────────
BIZPAY_URL=
# PREFERRED: the sandbox's tokens are short-lived, so let the framework mint
# them itself (POST {BIZPAY_URL}/api/auth/token with {username, apiKey}) and
# re-mint when one lapses mid-run.
BIZPAY_USERNAME=
BIZPAY_API_KEY=
# Fallback for when only a token is available. It expires within the hour, and
# once it does every BizPay assertion fails with a bodyless 401 — prefer the
# two variables above.
BIZPAY_API_TOKEN=
# Company under test (integration setting companyId)
BIZPAY_COMPANY_ID=545
